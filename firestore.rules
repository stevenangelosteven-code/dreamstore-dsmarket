rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Common Helpers
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Admins Collection
    match /admins/{adminId} {
      allow read: if isSignedIn() && (isOwner(adminId) || isAdmin());
      allow write: if false; // Only manageable through Firebase Console / Server auth
    }

    // Users Collection
    match /users/{userId} {
      allow read: if isSignedIn() && (isOwner(userId) || isAdmin());
      allow write: if isSignedIn() && (isOwner(userId) || isAdmin());
    }

    // Products Collection
    match /products/{productId} {
      allow read: if true; // Public catalog
      allow write: if isAdmin();
    }

    // Product Accounts Collection (credentials stock)
    match /productAccounts/{accountId} {
      allow read, write: if isAdmin();
    }

    // Orders Collection
    match /orders/{orderId} {
      allow read: if isSignedIn() && (resource.data.email == request.auth.token.email || isAdmin());
      allow create: if isSignedIn();
      allow update: if isAdmin();
      allow delete: if false;
    }

    // Payment Methods Collection
    match /paymentMethods/{methodId} {
      allow read: if true; // Public payment options
      allow write: if isAdmin();
    }

    // Activity Logs Collection
    match /activityLogs/{logId} {
      allow read, write: if isAdmin();
    }

    // Blacklist Collection
    match /blacklist/{blacklistId} {
      allow read, write: if isAdmin();
    }

    // Notifications Collection
    match /notifications/{notificationId} {
      allow read: if isSignedIn() && (resource.data.userEmail == request.auth.token.email || resource.data.targetRole == "admin" && isAdmin());
      allow write: if isAdmin();
    }

    // Topups Collection
    match /topups/{topupId} {
      allow read: if isSignedIn() && (resource.data.email == request.auth.token.email || isAdmin());
      allow create: if isSignedIn();
      allow update: if isAdmin();
      allow delete: if false;
    }

    // Chat Messages Collection
    match /csMessages/{messageId} {
      allow read: if isSignedIn() && (resource.data.userEmail == request.auth.token.email || isAdmin());
      allow create: if isSignedIn() || true; // CS Chat accessible
      allow update: if isAdmin();
      allow delete: if false;
    }

    // System Config Collection
    match /config/{configId} {
      allow read: if true; // Public store configs
      allow write: if isAdmin();
    }

    // Banner Config Collection
    match /banner/{bannerId} {
      allow read: if true; // Public banner config
      allow write: if isAdmin();
    }
  }
}
